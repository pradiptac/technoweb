# ---------------------------------------------------------------
# Repository root. Per-project ignores live in api/.gitignore and
# web/.gitignore — this file only covers things at the top level.
# ---------------------------------------------------------------

# Delivery archives — these are duplicated source, never commit them
*.zip

# OS noise
.DS_Store
Thumbs.db
desktop.ini

# Editors
.idea/
.vscode/
*.swp
*.swo

# Local scratch
/tmp/
/_to_delete/
*.local

# Claude Code session artifacts
.claude/

# Throwaway browser probes. They are written to verify one change and are
# not maintained afterwards; four have reached a commit by way of `git add -A`.
_*.mjs
_*.py

# Probe files from scripted testing — one of these held a live bearer token.
.tok
.pg
