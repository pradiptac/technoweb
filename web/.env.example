# Laravel REST API (server-side only — never exposed to the browser)
API_BASE_URL=http://localhost:8000

# Public site origin, used for canonical URLs, OG tags and JSON-LD
NEXT_PUBLIC_SITE_URL=https://www.technoware.in

# The origin a *browser* loads uploaded images from — Laravel builds those URLs
# from its own APP_URL, which is not necessarily the URL above. Optional: it
# falls back to API_BASE_URL's origin, which is right whenever the two agree.
# Set it when they do not, or the Content-Security-Policy will report every
# cover image as blocked and `npm run audit` will fail on it.
#
# It feeds a header computed during `next build`, so it belongs in the BUILD
# environment, not just the runtime one — the same rule API_BASE_URL follows.
# ASSET_ORIGIN=https://api.technoware.in

# For local frontend work without a running Laravel backend:
#   node mock-api.mjs        (serves the /api/v1 contract on :8899)
#   API_BASE_URL=http://127.0.0.1:8899 npm run dev

# The one hostname this site answers on. Set it and every request arriving at
# any other host is redirected here with a 301 — www to non-www, or the other
# way round. Leave it unset in development, or localhost:3000 redirects away
# and the dev server becomes unusable.
#
# It must agree with NEXT_PUBLIC_SITE_URL above and with FRONTEND_URL in the
# API's .env: those build every canonical, og:url, sitemap entry, campaign
# link, order link and unsubscribe link, and FRONTEND_URL is also the exact
# string CORS allows. Redirecting to www while the canonicals name the bare
# domain tells a crawler the page it was just sent to is not the real one.
#
# A redirect at the web server (Plesk/Apache) is better where you have access:
# it runs before Node is woken and covers static assets too. This is the
# in-application fallback, and it cannot be lost in a hosting migration.
# CANONICAL_HOST=www.technoware.in
