# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the example MUST be committed — it is the only record of which
# variables the app needs. `.env*` above would otherwise swallow it.
!.env.example

# TypeScript incremental build cache — machine-specific, not source
tsconfig.tsbuildinfo

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
