/vendor
/node_modules
# Laravel's package-discovery cache. Machine-generated by `composer install`
# and `artisan package:discover` — committing it causes merge conflicts and can
# carry another machine's absolute paths into a deploy.
/bootstrap/cache/*
!/bootstrap/cache/.gitignore
/public/build
/public/hot
/public/storage
/storage/*.key
/storage/pail
/storage/app/private/*
!/storage/app/private/.gitignore
.env
.env.backup
.env.production
.phpunit.result.cache
Homestead.json
Homestead.yaml
auth.json
npm-debug.log
yarn-error.log
/.fleet
/.idea
/.vscode
/.phpactor.json
/storage/app/purifier
.env.backup*
