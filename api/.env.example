APP_NAME=Technoware
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.technoware.in

APP_LOCALE=en
APP_TIMEZONE=Asia/Kolkata

LOG_CHANNEL=stack
LOG_LEVEL=warning

# Staff password sign-in while Settings has passwords switched off -- the
# way back in when mail is broken and no code can arrive. Leave false.
AUTH_PASSWORD_BREAK_GLASS=false

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=technoware
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# `file`, not `database`: every Cache::get on the database store is a MySQL
# query, and the settings map, the rate limiter and the scheduler heartbeat are
# all read on ordinary requests. The file store keeps those on local disk with
# the same atomic add/lock semantics; `array` is the one store that does NOT
# outlive a request (the heartbeat would never be seen). The queue worker and
# the web process must share storage/framework/cache — the same user under
# Plesk. Use `redis` if there is one.
CACHE_STORE=file
QUEUE_CONNECTION=database

FILESYSTEM_DISK=public

# Origins allowed to call this API. The Next.js frontend runs on its own host.
FRONTEND_URL=https://www.technoware.in
SANCTUM_STATEFUL_DOMAINS=www.technoware.in

# The address(es) the Next.js server connects to this API from — the only
# callers whose X-Forwarded-For is believed, so rate limits count visitors
# rather than the Next server. Loopback when both run on one machine (the
# Plesk layout); the Next host's address if not. Never `*`. Comma-separated,
# CIDR accepted. See config/trustedproxy.php.
TRUSTED_PROXIES=127.0.0.1,::1

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=support@technoware.in
MAIL_FROM_NAME="${APP_NAME} Support"

# Max upload size for ticket attachments, in kilobytes
TICKET_ATTACHMENT_MAX_KB=10240

# Backups (docs/backups.md). Where mysqldump is - a folder or the binary;
# blank looks on PATH, and without it the database is dumped in PHP.
BACKUP_MYSQLDUMP_PATH=
# auto | mysqldump | php
BACKUP_DUMPER=auto
# true lets a backup go to a server on a private address (a NAS on the LAN).
BACKUP_ALLOW_PRIVATE_HOSTS=false

# The newsletter's website crawl (Campaign -> Subscribers -> From a website).
# Milliseconds between two requests to one site; true reads a site on this
# machine, and is ignored unless APP_ENV=local.
CRAWL_DELAY_MS=1000
CRAWL_ALLOW_PRIVATE=false

# AI features (the website assistant, the SEO assistant, alt text, drafts) all
# call OpenRouter. The key is normally saved in the console (Settings -> API
# keys), where it is encrypted; this is the fallback for a fresh install. It
# must be an OpenRouter key (openrouter.ai -> Keys) - an OpenAI key is refused
# there. Your own Google AI Studio and OpenAI keys go in at OpenRouter itself.
# OPENROUTER_API_KEY=
# An OpenRouter model id, maker/model. Blank means google/gemini-2.5-flash,
# which a free Google AI Studio key added at OpenRouter can call.
# AI_MODEL=google/gemini-2.5-flash
