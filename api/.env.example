APP_NAME=Technoware
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.technoware.in

APP_LOCALE=en
APP_TIMEZONE=Asia/Kolkata

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=technoware
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

FILESYSTEM_DISK=public

# Origins allowed to call this API. The Next.js frontend runs on its own host.
FRONTEND_URL=https://www.technoware.in
SANCTUM_STATEFUL_DOMAINS=www.technoware.in

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=support@technoware.in
MAIL_FROM_NAME="${APP_NAME} Support"

# Max upload size for ticket attachments, in kilobytes
TICKET_ATTACHMENT_MAX_KB=10240
