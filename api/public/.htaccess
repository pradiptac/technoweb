<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization header — Plesk/Apache strips it by default, which
    # silently breaks every Bearer-token request.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Redirect trailing slashes if not a folder
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send requests to the front controller
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Never serve dotfiles or environment files
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Uploaded files are served straight from /storage by Apache, so the headers
# they carry are the only thing between a stored file and a browser deciding
# for itself what to do with it.
#
# `nosniff` is the important one, and it is set for everything under public/ —
# including the API's own JSON. Without it a browser may disregard the
# Content-Type and re-classify a file by looking at its bytes, which is how a
# text-ish upload holding markup becomes a document. `SvgSanitiser` cleans an
# SVG on the way in; this is the half that holds for a file type nobody thought
# to sanitise.
#
# The strict policy is scoped to `.svg` by filename rather than to `/storage/`
# by path, for two reasons. `<LocationMatch>` is not permitted in .htaccess at
# all — it is a server-config directive, and Apache answers 500 for the whole
# vhost if it appears here. And the same policy applied to every upload would
# take PDFs with it: `sandbox` stops Chrome's built-in viewer rendering one
# inline, so a datasheet would download instead of opening.
#
# `sandbox` is what makes an SVG opened directly inert — no scripts, no forms,
# a unique origin — and it costs an `<img>` embed nothing, because an image
# referenced by a page never ran scripts anyway.
#
# Requires `AllowOverride FileInfo` (or All) on this directory, which Plesk
# grants by default. If mod_headers is absent the block is skipped silently, so
# the sanitiser stays the boundary rather than this.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"

    <FilesMatch "\.svg$">
        Header always set Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; sandbox"
    </FilesMatch>
</IfModule>

# Uploads are immutable at their address, so a browser may keep them for a
# year. Every file under /storage is written under a hashed name, and an edit
# that rewrites one in place versions its URL with `?v=<updated_at>` — so a
# cached copy can never be the wrong bytes, and re-validating one on every
# page view is a round trip that answers "unchanged" every time. Scoped to the
# file types the media library accepts rather than to /storage/ (see the
# `<LocationMatch>` note above): a JSON response must stay uncacheable and
# `.php` never reaches this block. `immutable` is what stops the browser
# re-validating on a reload.
#
# The API's own responses are compressed as well. Plesk usually enables
# mod_deflate globally; this is the same rule stated where the JSON is served,
# so it does not depend on a panel setting nobody can see from the repository.
<IfModule mod_headers.c>
    <FilesMatch "\.(jpe?g|png|gif|webp|avif|svg|woff2?|pdf|mp4|webm)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    <FilesMatch "\.(jpe?g|png|gif|webp|avif|svg|woff2?|pdf|mp4|webm)$">
        ExpiresDefault "access plus 1 year"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE application/json text/html text/plain text/xml image/svg+xml
</IfModule>
